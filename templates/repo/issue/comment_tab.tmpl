{{$textareaContent := .BodyQuery}}
{{if not $textareaContent}}{{$textareaContent = .IssueTemplate}}{{end}}
{{if not $textareaContent}}{{$textareaContent = .PullRequestTemplate}}{{end}}
{{if not $textareaContent}}{{$textareaContent = .content}}{{end}}

<div class="field">
	{{template "shared/combomarkdowneditor" (dict
		"CustomInit" true
		"MarkdownEditorContext" (ctx.MiscUtils.MarkdownEditorComment $.Repository)
		"TextareaName" "content"
		"TextareaContent" $textareaContent
		"TextareaPlaceholder" (ctx.Locale.Tr "repo.diff.comment.placeholder")
		"DropzoneParentContainer" "form, .ui.form"
	)}}
</div>

{{if .PageIsComparePull}}
	<div class="field">
		<button type="button" class="ui button" id="ai-generate-description"
			data-base="{{$.BaseBranch}}" data-head="{{$.HeadBranch}}"
			data-url="{{AppSubUrl}}/{{$.Repository.FullName}}/compare/generate-description"
			data-label-generate="{{ctx.Locale.Tr "repo.pulls.generate_description"}}"
			data-label-regenerate="{{ctx.Locale.Tr "repo.pulls.regenerate_description"}}"
			data-label-generating="{{ctx.Locale.Tr "repo.pulls.generating_description"}}"
			data-label-overwrite="{{ctx.Locale.Tr "repo.pulls.confirm_overwrite"}}"
			data-label-failed="{{ctx.Locale.Tr "repo.pulls.generate_description_failed"}}">{{ctx.Locale.Tr "repo.pulls.generate_description"}}</button>
		<span id="ai-generate-description-status" class="tw-ml-2 tw-text-sm tw-text-text-light"></span>
	</div>
{{end}}

{{if .IsAttachmentEnabled}}
	<div class="field">
		{{template "repo/upload" .}}
	</div>
{{end}}
